// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "format_on_save": "on",
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "Tokyo Night Storm",
  },
  "wrap_guides": [120],
  "hard_tabs": false,
  "tab_size": 2,
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "!solargraph",
        "!rubocop",
        "!sorbet",
        "!steep",
        "!kanayago",
      ],
    },
    "HTML+ERB": {
      "language_servers": ["herb", "ruby-lsp", "..."],
    },
    "JS+ERB": {
      "language_servers": ["ruby-lsp", "..."],
    },
    "YAML+ERB": {
      "language_servers": ["ruby-lsp", "..."],
    },
  },
}
